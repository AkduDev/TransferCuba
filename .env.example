# TransferCuba — variables de entorno

# Mapa/rutas: sin API keys (OpenFreeMap + OSM + OSRM/Nominatim gratuitos).

# Base de datos PostgreSQL + PostGIS (Sprint 2).
# Opcional en desarrollo: sin esta variable, la API usa el fallback
# in-memory con el seed (docs/roadmap.md).
# Producción: Neon serverless Postgres — crea el proyecto en neon.tech,
# ejecuta db/schema.sql y db/seed.sql desde el SQL editor, y copia la
# connection string (incluye sslmode=require automáticamente).
# Ejemplo:
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Panel de administración — LOGIN REAL contra el servidor (deuda técnica resuelta).
# Sin estas variables el login devuelve 503 y las acciones admin del API dan 401.
# Usuario y password validados en POST /api/auth/login (comparación timing-safe).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Secret para firmar la sesión (cookie HttpOnly, HMAC-SHA256). Si se omite,
# se deriva del password: define un valor propio para una firma independiente.
ADMIN_TOKEN_SECRET=

# Cloudflare R2 — almacenamiento de fotos de negocios.
# Crea un bucket R2 en el dashboard de Cloudflare (gratuito, 10GB sin egress).
# En Settings → S3 API, genera un API Token con permisos Object Read & Write.
# R2_PUBLIC_URL es la URL pública del bucket (ej: https://pub-xxx.r2.dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
